# Vortexsoft Group — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to Git!

# ── MySQL Database ──────────────────────────────────────────
DB_HOST=localhost
DB_NAME=u696371114_vortexsoftcom
DB_USER=u696371114_vortexsoftcom
DB_PASS=YOUR_DATABASE_PASSWORD_HERE

# ── SMTP / Mail (if using SMTP instead of PHP mail) ────────
